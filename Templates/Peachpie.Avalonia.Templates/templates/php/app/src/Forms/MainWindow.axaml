<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="450"
        x:Class="PeachpieAvaloniaAppTemplate.Forms.MainWindow"
        Title="PeachpieAvaloniaAppTemplate">
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Name="DateView" HorizontalAlignment="Center"/>
        <Button Name="RefreshButton" Content="Refresh time" Command="{Binding RefreshTimeCommand}" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
